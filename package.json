{
  "name": "shadow-squad",
  "version": "1.0.0",
  "description": "Shadow Squad - real-time tactics stealth game for CrazyGames",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --outfile=dist/bundle.js && node scripts/pack.mjs",
    "dev": "esbuild src/main.js --bundle --outfile=dist/bundle.js --watch --servedir=dist",
    "test:viewport": "node tests/hardening-viewport.mjs",
    "test:refresh": "node tests/hardening-refresh.mjs",
    "test:soak": "node tools/e2e-soak.mjs",
    "test:polish": "node tests/final-polish.mjs",
    "test:cover-brightness": "node scripts/check-cover-brightness.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1"
  }
}
